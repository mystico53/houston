{
  "seed": 1,
  "name": "Houston",
  "about": "A playful satellite game for trying comment → fix → preview with Claude Code.",
  "repo": "https://github.com/mystico53/houston",
  "folder": "houston",
  "stages": [
    { "title": "Check your machine", "steps": [
      { "title": "Git", "check": "git --version", "help": "https://git-scm.com/downloads" },
      { "title": "Node.js 20 or newer", "check": "node --version", "min": "20.9", "help": "https://nodejs.org/en/download" },
      { "title": "GitHub CLI", "check": "gh --version", "help": "https://cli.github.com" },
      { "title": "Claude Code", "check": "claude --version", "help": "https://code.claude.com/docs/en/setup" }
    ]},
    { "title": "Sign in", "steps": [
      { "title": "GitHub", "check": "gh auth status", "run": "gh auth login --hostname github.com --web --git-protocol https", "then": "gh auth setup-git", "visible": true },
      { "title": "Claude", "check": "claude auth status", "run": "claude auth login", "visible": true },
      { "title": "Your GitHub account", "choose": "github-owner" }
    ]},
    { "title": "Get the code", "in": "folder", "steps": [
      { "title": "Make your own copy", "check": { "exists": ".git" }, "run": ["gh repo fork {repo} --clone {githubOrgFlag} -- .", "git clone {repo} ."] },
      { "title": "Point Git at your copy", "check": "git remote -v", "expect": "github\\.com[/:]mystico53/houston", "run": "gh repo fork --remote {githubOrgFlag}" },
      { "title": "Keep pull requests in your copy", "check": "git config remote.origin.gh-resolved", "expect": "^\\s*base\\s*$", "run": "gh repo set-default origin" },
      { "title": "Install packages", "check": { "exists": "node_modules/.package-lock.json" }, "run": "npm install" },
      { "title": "Sign in to Vercel", "check": "npx vercel whoami", "run": "npx vercel login", "visible": true },
      { "title": "Your Vercel team", "choose": "vercel-team" },
      { "title": "Make your Vercel project", "check": "node scripts/vercel-link-check.mjs {vercelTeamId}", "run": "npx vercel link --yes --project houston --scope {vercelTeam}" },
      { "title": "Deploy from your copy", "check": "node scripts/vercel-git-check.mjs", "run": "node scripts/vercel-git-connect.mjs",
        "hint": "If it says \"Failed to connect\", Vercel can't see your GitHub copy yet. Open https://github.com/apps/vercel, install it on your GitHub account (just houston is fine), then press Try again on the card." },
      { "title": "Connect Claude to Vercel", "check": "claude mcp list", "expect": "vercel.*(Connected|✓)", "run": "claude", "visible": true,
        "hint": "Claude first asks whether you trust this folder: choose Yes. Type /mcp, pick vercel, choose Authenticate and approve in the browser. Then ask Claude: list my Vercel projects. If Claude shows a vercel.com link instead, open it and approve your team, then ask again. When you see houston, type /exit." }
    ]},
    { "title": "Start the site", "in": "folder", "steps": [
      { "title": "Run Houston", "run": "npm run dev", "background": true, "port": "from-output" }
    ]}
  ],
  "island": { "name": "Houston", "chat": "Houston", "browser": "site", "note": "START_HERE.md", "firstTask": "Make the planet pinker" },
  "live": { "title": "Go live", "run": "npx vercel deploy --prod --yes" }
}
